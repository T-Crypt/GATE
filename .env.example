HOST=127.0.0.1
PORT=4177
GATE_DATA_DIR=./data
GATE_JSON_LIMIT=1mb
GATE_OUTPUT_LIMIT_BYTES=2000000
LOG_LEVEL=info
# ALLOW_REMOTE_BIND=false

# Remote GitHub observation (read-only PRs and repo issues). Optional.
# Provide the token either here in a local .env file (gitignored) OR as an
# environment variable in your shell/CI. Never commit it anywhere.
GATE_GITHUB_TOKEN=
# For GitHub Enterprise Server, point at its API root, e.g. https://github.example/api/v3
GATE_GITHUB_API_URL=https://api.github.com

# Windows only: override the native OpenCode executable path resolved from the
# opencode.cmd shim. Ignored on Linux/macOS (see docs: Provider adapters).
# OPENCODE_BIN_PATH=
