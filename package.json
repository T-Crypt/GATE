{
  "name": "gate",
  "version": "0.2.0",
  "description": "Gated Agent Timeline Engine — a local control plane for human-reviewed AI development",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "mcp": "node server/mcp/stdio.js",
    "test": "node --test",
    "test:unit": "node --test tests/unit",
    "test:integration": "node --test tests/integration",
    "test:browser": "playwright test",
    "lint": "find server public/js tests -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check": "npm run lint && npm test && npm run test:browser"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "ws": "^8.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "supertest": "^7.2.2"
  }
}
