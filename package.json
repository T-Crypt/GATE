{
  "name": "project-mcp",
  "version": "0.2.0",
  "description": "Local control plane for human-reviewed AI development",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "test:unit": "node --test tests/unit",
    "test:integration": "node --test tests/integration",
    "lint": "find server public/js tests -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  }
}
